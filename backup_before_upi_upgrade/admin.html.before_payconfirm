// ==================== ACTIVITY ====================
async function loadActivity(page){
currentActivityPage=page;
const filter=document.getElementById('activityFilter').value;
try{
const r=await fetch('/api/admin/activity?page='+page+'&filter='+encodeURIComponent(filter));
const d=await r.json();
if(d.success){
document.getElementById('activityCount').textContent=d.total+' entries';
const tb=document.getElementById('activityBody');
if(d.activity.length===0){
tb.innerHTML='<tr><td colspan="5" style="text-align:center;color:var(--text3)">No activity</td></tr>';
return;
}
tb.innerHTML=d.activity.map(a=>{
const dt=a.created_at?String(a.created_at).substring(0,16):'-';
const badge=a.action==='login'?'blue':a.action==='register'?'green':a.action==='change_password'?'red':a.action==='payment'?'purple':'orange';
return '<tr>'+
'<td><strong>'+(a.name||'-')+'</strong><br><span style="font-size:10px;color:var(--text3)">'+a.email+'</span></td>'+
'<td><span class="badge '+badge+'">'+a.action+'</span></td>'+
'<td>'+(a.service_type||'-')+'</td>'+
'<td style="font-size:11px">'+(a.details||'-')+'</td>'+
'<td style="font-size:11px">'+dt+'</td>'+
'</tr>';
}).join('');
const pg=document.getElementById('activityPagination');
pg.innerHTML='';
if(d.pages>1){
for(let i=1;i<=d.pages;i++){
pg.innerHTML+='<button class="'+(i===page?'active':'')+'" onclick="loadActivity('+i+')">'+i+'</button>';
}
}
}
}catch(e){console.error('Activity error:',e)}
}

// ==================== SETTINGS ====================
async function loadSettings(){
try{
const r=await fetch('/api/admin/settings');
const d=await r.json();
if(d.success&&d.settings){
const s=d.settings;
document.getElementById('setFreeBrs').value=s.free_brs_limit;
document.getElementById('setFreeGst').value=s.free_gst_limit;
document.getElementById('setFreeBook').value=s.free_bookkeeping_limit;
document.getElementById('setBrsPrice').value=s.brs_price;
document.getElementById('setGstPrice').value=s.gst_price;
document.getElementById('setBookPrice').value=s.bookkeeping_price;
document.getElementById('setTallyPrice').value=s.tally_push_price;
document.getElementById('setSiteName').value=s.site_name;
document.getElementById('toggleRegistration').className='toggle'+(s.registration_enabled==='true'?' on':'');
document.getElementById('toggleMaintenance').className='toggle'+(s.maintenance_mode==='true'?' on':'');
}
}catch(e){console.error(e)}
}

async function saveSettings(){
const settings={
free_brs_limit:document.getElementById('setFreeBrs').value,
free_gst_limit:document.getElementById('setFreeGst').value,
free_bookkeeping_limit:document.getElementById('setFreeBook').value,
brs_price:document.getElementById('setBrsPrice').value,
gst_price:document.getElementById('setGstPrice').value,
bookkeeping_price:document.getElementById('setBookPrice').value,
tally_push_price:document.getElementById('setTallyPrice').value,
site_name:document.getElementById('setSiteName').value,
registration_enabled:document.getElementById('toggleRegistration').classList.contains('on')?'true':'false',
maintenance_mode:document.getElementById('toggleMaintenance').classList.contains('on')?'true':'false'
};
try{
const r=await fetch('/api/admin/settings',{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify({settings})});
const d=await r.json();
if(d.success)showToast('Settings saved!');
}catch(e){showToast('Error saving settings',true)}
}

async function toggleMaintenanceMode(){
const current=document.getElementById('toggleMaintenance').classList.contains('on');
const newState=!current;
try{
await fetch('/api/admin/maintenance',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({enabled:newState})});
document.getElementById('toggleMaintenance').className='toggle'+(newState?' on':'');
showToast('Maintenance mode: '+(newState?'ON':'OFF'));
}catch(e){showToast('Error',true)}
}

// ==================== HEALTH ====================
async function loadHealth(){
try{
const r=await fetch('/api/admin/health');
const d=await r.json();
if(d.success&&d.health){
