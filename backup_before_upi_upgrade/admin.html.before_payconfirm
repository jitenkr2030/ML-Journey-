document.getElementById('healthCleaned').textContent=h.expired_cleaned;
document.getElementById('healthTime').textContent=h.server_time;
}
}catch(e){console.error(e)}
}

async function cleanSessions(){
try{
await loadHealth();
showToast('Expired sessions cleaned');
}catch(e){showToast('Error',true)}
}

