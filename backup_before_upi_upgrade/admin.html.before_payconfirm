'<tr><td>GSTIN</td><td style="text-align:right">'+(u.gstin||'-')+'</td></tr>'+
'<tr><td>Phone</td><td style="text-align:right">'+(u.phone||'-')+'</td></tr>'+
'<tr><td>Role</td><td style="text-align:right">'+(u.is_admin?'<span class="badge red">Admin</span>':'<span class="badge blue">User</span>')+'</td></tr>'+
