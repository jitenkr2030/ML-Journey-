}

function editUserFromDetail(){
closeModal('userDetailModal');
editUser(selectedUserId,'','','','','false');
}

async function resetUserFromDetail(){
if(!confirm('Reset usage for this user?'))return;
await fetch('/api/admin/users/'+selectedUserId+'/reset-usage',{method:'POST'});
showToast('Usage reset!');
closeModal('userDetailModal');
loadUsers(currentUsersPage);
loadStats();
}

async function resetPasswordFromDetail(){
const pw=prompt('Enter new password for this user (min 6 chars):');
if(!pw||pw.length<6){showToast('Password must be 6+ chars',true);return}
const r=await fetch('/api/admin/users/'+selectedUserId+'/reset-password',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({password:pw})});
const d=await r.json();
if(d.success){showToast('Password reset! Sessions cleared.');closeModal('userDetailModal')}
}

async function deleteUser(id){
if(!confirm('Delete this user and ALL their data? This cannot be undone.'))return;
try{
const r=await fetch('/api/admin/users/'+id,{method:'DELETE'});
const d=await r.json();
if(d.success){showToast('User deleted');loadUsers(1);loadStats()}
}catch(e){console.error(e)}
}

function editUser(id,name,firm,gstin,phone,isAdmin){
document.getElementById('editUserId').value=id;
document.getElementById('editName').value=name;
document.getElementById('editFirm').value=firm;
document.getElementById('editGstin').value=gstin;
document.getElementById('editPhone').value=phone;
document.getElementById('editRole').value=isAdmin?'admin':'user';
document.getElementById('editUserModal').classList.add('show');
}

async function saveUser(){
const id=document.getElementById('editUserId').value;
const body={
name:document.getElementById('editName').value,
firm_name:document.getElementById('editFirm').value,
gstin:document.getElementById('editGstin').value,
phone:document.getElementById('editPhone').value,
is_admin:document.getElementById('editRole').value==='admin'
};
try{
const r=await fetch('/api/admin/users/'+id,{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});
const d=await r.json();
if(d.success){closeModal('editUserModal');showToast('User updated');loadUsers(currentUsersPage)}
}catch(e){showToast('Error updating user',true)}
}

