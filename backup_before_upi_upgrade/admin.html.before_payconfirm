<script>
let currentUsersPage=1;
let currentActivityPage=1;
let currentPaymentsPage=1;
let searchTimeout=null;
let selectedUserId=null;

// ==================== TABS ====================
function switchTab(tab, el){
document.querySelectorAll('.tab').forEach(t=>t.classList.remove('active'));
el.classList.add('active');
['overview','users','payments','activity','settings','health'].forEach(t=>{
const el=document.getElementById('tab'+t.charAt(0).toUpperCase()+t.slice(1));
if(el)el.style.display=t===tab?'':'none';
});
if(tab==='users')loadUsers(1);
if(tab==='activity')loadActivity(1);
if(tab==='payments')loadPayments(1);
if(tab==='settings')loadSettings();
if(tab==='health')loadHealth();
}

function closeModal(id){document.getElementById(id).classList.remove('show')}

function showToast(msg, isError){
const t=document.getElementById('toast');
t.textContent=msg;
t.className='toast show'+(isError?' error':'');
setTimeout(()=>{t.className='toast'},3000);
}

function toggleSetting(el){el.classList.toggle('on')}

function debounceSearch(){
clearTimeout(searchTimeout);
searchTimeout=setTimeout(()=>loadUsers(1),500);
}

function exportUsers(){window.location.href='/api/admin/export/users'}
function exportActivity(){window.location.href='/api/admin/export/activity'}

async function logout(){
try{await fetch('/api/auth/logout',{method:'POST'})}catch(e){}
window.location.href='/';
}

// ==================== AUTH CHECK ====================
async function loadAdmin(){
try{
const r=await fetch('/api/auth/me');
const d=await r.json();
if(!d.success||!d.user){
document.getElementById('loginPrompt').style.display='block';
document.getElementById('adminContent').style.display='none';
return;
}

const ar=await fetch('/api/admin/stats');
if(ar.status===403){
document.getElementById('notAdmin').style.display='block';
document.getElementById('adminContent').style.display='none';
return;
}
if(ar.status===401){
document.getElementById('loginPrompt').style.display='block';
document.getElementById('adminContent').style.display='none';
return;
}

document.getElementById('loginPrompt').style.display='none';
document.getElementById('notAdmin').style.display='none';
document.getElementById('adminContent').style.display='block';
document.getElementById('adminName').textContent=d.user.email;
loadAll();
}catch(e){
document.getElementById('loginPrompt').style.display='block';
}
}

async function loadAll(){
await loadStats();
await loadUsers(1);
await loadActivity(1);
}

// ==================== STATS ====================
async function loadStats(){
try{
const r=await fetch('/api/admin/stats');
const d=await r.json();
if(d.success&&d.stats){
const s=d.stats;
document.getElementById('statUsers').textContent=s.total_users;
document.getElementById('statUsersSub').textContent=s.today_new_users+' today, '+s.week_new_users+' this week';
document.getElementById('statSessions').textContent=s.active_sessions;
document.getElementById('statActivity').textContent=s.total_activity;
document.getElementById('statActivitySub').textContent=s.today_logins+' logins today';
const totalOps=s.total_brs+s.total_gst+s.total_bookkeeping;
document.getElementById('statOps').textContent=totalOps;
document.getElementById('statOpsSub').textContent=s.total_brs+' BRS, '+s.total_gst+' GST, '+s.total_bookkeeping+' Book';
document.getElementById('statRevenue').textContent='₹'+s.total_revenue;
document.getElementById('statRevenueSub').textContent=s.total_reconciliations+' total reconciliations';

// Growth chart
if(s.growth&&s.growth.length>0){
const max=Math.max(...s.growth.map(g=>g.count),1);
document.getElementById('growthChart').innerHTML=s.growth.map(g=>{
const h=Math.max(5,(g.count/max)*100);
const day=g.day.substring(5);
return '<div class="bar" style="height:'+h+'%"><div class="bar-label">'+day+' ('+g.count+')</div></div>';
}).join('');
}

// Service usage bars
const maxSvc=Math.max(s.total_brs,s.total_gst,s.total_bookkeeping,1);
document.getElementById('brsBar').style.width=Math.min(100,(s.total_brs/maxSvc)*100)+'%';
document.getElementById('brsBarText').textContent=s.total_brs;
document.getElementById('gstBar').style.width=Math.min(100,(s.total_gst/maxSvc)*100)+'%';
document.getElementById('gstBarText').textContent=s.total_gst;
document.getElementById('bookBar').style.width=Math.min(100,(s.total_bookkeeping/maxSvc)*100)+'%';
document.getElementById('bookBarText').textContent=s.total_bookkeeping;

// Top users
if(s.top_users&&s.top_users.length>0){
document.getElementById('topUsersBody').innerHTML=s.top_users.map(u=>
'<tr><td>'+(u.name||'-')+'</td><td style="font-size:11px">'+u.email+'</td><td>'+(u.firm_name||'-')+'</td><td>'+u.total_ops+'</td><td>₹'+(u.total_paid||0)+'</td><td style="font-size:11px">'+(u.last_login?String(u.last_login).substring(0,16):'never')+'</td></tr>'
).join('');
}
}
}catch(e){console.error('Stats error:',e)}
}

// ==================== USERS ====================
async function loadUsers(page){
currentUsersPage=page;
const search=document.getElementById('userSearch').value;
try{
const r=await fetch('/api/admin/users?page='+page+'&search='+encodeURIComponent(search));
const d=await r.json();
if(d.success){
document.getElementById('userCount').textContent=d.total+' users';
const tb=document.getElementById('usersBody');
if(d.users.length===0){
tb.innerHTML='<tr><td colspan="12" style="text-align:center;color:var(--text3)">No users found</td></tr>';
return;
}
tb.innerHTML=d.users.map(u=>{
const created=u.created_at?String(u.created_at).substring(0,10):'-';
const roleBadge=u.is_admin?'<span class="badge red">Admin</span>':'<span class="badge blue">User</span>';
return '<tr style="cursor:pointer" onclick="showUserDetail('+u.id+')">'+
'<td>'+u.id+'</td>'+
'<td><strong>'+(u.name||'-')+'</strong></td>'+
'<td style="font-size:11px">'+u.email+'</td>'+
'<td>'+(u.firm_name||'-')+'</td>'+
'<td>'+roleBadge+'</td>'+
'<td><span class="badge blue">'+u.free_brs_used+'</span></td>'+
'<td><span class="badge green">'+u.free_gst_used+'</span></td>'+
'<td><span class="badge orange">'+u.free_bookkeeping_used+'</span></td>'+
'<td>'+u.total_reconciliations+'</td>'+
'<td style="color:var(--green)">₹'+u.total_paid+'</td>'+
'<td style="font-size:11px">'+created+'</td>'+
'<td onclick="event.stopPropagation()">'+
'<button class="btn btn-xs btn-outline" onclick="editUser('+u.id+',\''+(u.name||'')+'\',\''+(u.firm_name||'')+'\',\''+(u.gstin||'')+'\',\''+(u.phone||'')+'\','+(u.is_admin?'true':'false')+')">Edit</button> '+
'<button class="btn btn-xs btn-danger" onclick="deleteUser('+u.id+')">Del</button>'+
'</td></tr>';
}).join('');

const pg=document.getElementById('usersPagination');
pg.innerHTML='';
if(d.pages>1){
for(let i=1;i<=d.pages;i++){
pg.innerHTML+='<button class="'+(i===page?'active':'')+'" onclick="loadUsers('+i+')">'+i+'</button>';
}
}
}
}catch(e){console.error('Users error:',e)}
}

